# local 프로필에서만 사용하는 폐기 가능한 개발 설정이다.
SPRING_PROFILES_ACTIVE=local
DB_URL=jdbc:postgresql://localhost:5432/mulino_coreano
DB_USERNAME=mulino_app
DB_PASSWORD=replace-me
MULINO_LOCAL_SERVICE_SECRET=replace-with-a-local-worker-secret

# Queued model runtime: CODEX or CLAUDE; invalid values reject startup.
MULINO_AGENT_RUNTIME=CODEX
