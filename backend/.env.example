# 예제 전용: 실제 비밀은 .env 또는 shell 환경에만 저장한다.
# Spring Boot는 .env를 자동으로 읽지 않는다. 실행 shell에서 export한 뒤 bootRun한다.
DB_URL=jdbc:postgresql://localhost:5432/mulino_coreano
DB_USERNAME=replace-with-local-database-user
DB_PASSWORD=replace-with-local-database-password

# PoC 로컬 신원 (Auth0/OAuth는 #21·#22에서 보류).
# 사람: 요청 헤더 X-Mulino-Local-Role=MANAGER|OPERATOR|QC|ADMIN|VIEWER
# 실행기: Authorization: Bearer $MULINO_WORKER_TOKEN. 비워 두면 실행기 경로를 열지 않는다.
MULINO_WORKER_TOKEN=replace-with-a-long-random-local-secret
