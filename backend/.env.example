# 예제 전용: 실제 비밀은 .env 또는 shell 환경에만 저장한다.
# Spring Boot는 .env를 자동으로 읽지 않는다. 실행 shell에서 export한 뒤 bootRun한다.
DB_URL=jdbc:postgresql://localhost:5432/mulino_coreano
DB_USERNAME=replace-with-local-database-user
DB_PASSWORD=replace-with-local-database-password

# Auth0 issuer는 실제 tenant의 정확한 HTTPS URL(보통 끝의 / 포함)로 지정한다.
MULINO_AUTH_ISSUER=https://your-tenant.example.auth0.com/
MULINO_API_AUDIENCE=urn:mulino:erp-api
# 비워두면 표준 issuer discovery로 JWKS를 찾는다. override도 HTTPS만 허용한다.
MULINO_AUTH_JWKS_URI=
# 이 값이 비어 있으면 worker:dispatch 서비스 권한을 부여하지 않는다.
MULINO_WORKER_CLIENT_ID=replace-with-worker-client-id

# PoC 로컬 스텁: Auth0 대신 spring.profiles.active=local
# 요청 헤더 X-Mulino-Local-Role=MANAGER|QC|ADMIN|OPERATOR|VIEWER (기본 MANAGER)
# SPRING_PROFILES_ACTIVE=local
