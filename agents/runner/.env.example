# Node 22+에서 node --env-file=.env src/main.js 실행. 실제 .env는 커밋하지 않습니다.
# 백엔드의 MULINO_WORKER_TOKEN과 같은 값을 둡니다(Auth0 M2M은 #21·#22에서 보류).
MULINO_WORKER_TOKEN=replace-with-the-backend-worker-token
MULINO_WORKER_ID=local-worker-1
MULINO_API_BASE=http://127.0.0.1:8080/api/v1
# 호스트 실행기 설정입니다. 컨테이너의 mulino에는 MULINO_API_URL로 전달됩니다.
MULINO_AGENT_API_URL=http://host.docker.internal:8080/api/v1
# scripts/build-image.mjs로 생성한 이미지, 전용 로그인 볼륨, 런타임을 지정합니다.
MULINO_RUNTIME_IMAGE=mulino-agent-runtime:codex-0.154.0-claude-2.1.282
MULINO_AUTH_VOLUME=mulino-codex-auth
# CLAUDE 또는 CODEX를 지정합니다(기본값 CODEX).
MULINO_AGENT_RUNTIME=CODEX
# 해당 런타임 계정에서 사용할 수 있는 모델 이름을 명시합니다.
MULINO_AGENT_MODEL=YOUR_MODEL
