# Node 22+에서 node --env-file=.env src/main.js 실행. 실제 .env는 커밋하지 않습니다.
MULINO_AUTH_ISSUER=https://YOUR_TENANT.auth0.com/
MULINO_WORKER_CLIENT_ID=YOUR_WORKER_M2M_CLIENT_ID
MULINO_WORKER_CLIENT_SECRET=YOUR_WORKER_M2M_CLIENT_SECRET
MULINO_WORKER_ID=local-worker-1
MULINO_API_BASE=http://127.0.0.1:8080/api/v1
# 호스트 실행기 설정입니다. 컨테이너의 mulino에는 MULINO_API_URL로 전달됩니다.
MULINO_AGENT_API_URL=http://host.docker.internal:8080/api/v1
# 실제 이미지와 전용 로그인 볼륨 준비는 후속 CLI/런타임 단계입니다.
MULINO_RUNTIME_IMAGE=mulino-runtime:local
MULINO_CODEX_AUTH_VOLUME=mulino-codex-auth
