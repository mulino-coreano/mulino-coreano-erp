# 비밀 없는 예제. 복사한 .env는 gitignored이며 저장소에 커밋하지 않습니다.
MULINO_PUBLIC_ORIGIN=https://your-fixed-domain.ngrok-free.app
MULINO_AUTH_ISSUER=https://your-tenant.auth0.com/
# MULINO_MCP_AUDIENCE는 생략 시 위 public origin + /mcp
MULINO_API_AUDIENCE=urn:mulino:erp-api
MULINO_AUTH0_CLIENT_ID=replace-with-obo-client-id
MULINO_AUTH0_CLIENT_SECRET=replace-with-local-secret
MULINO_API_BASE=http://localhost:8080/api/v1
MULINO_API_TIMEOUT_MS=10000
MULINO_HOST=127.0.0.1
MULINO_PORT=3001
# stdio 전용: ERP audience access token을 로컬에서 주입하세요.
# MULINO_API_TOKEN=replace-with-erp-access-token
